  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://docs.cloud.google.com/bigquery/docs/use-bigquery-mcp",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "keywords": [
    "google cloud bigquery",
    "google cloud",
