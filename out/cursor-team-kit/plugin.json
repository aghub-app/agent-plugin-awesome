{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cursor-team-kit",
  "version": "1.2.0",
  "description": "Internal engineering team workflows for CI, code review, shipping, control-cli, control-ui, verify-this, test reliability, code cleanup, and work summaries. Designed to work without requiring third-party service integrations.",
  "author": {
    "name": "Eric Zakariasson"
  },
  "homepage": "https://github.com/cursor/plugins",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "keywords": [
    "cursor-team-kit",
    "ci",
    "code-review",
    "shipping",
    "testing",
    "verification",
    "local-automation"
  ],
  "extensions": {
    "com.cursor": {
      "displayName": "Cursor Team Kit",
      "logo": "assets/avatar.png",
      "category": "developer-tools",
      "tags": [
        "internal-workflows",
        "quality",
        "delivery",
        "review",
        "automation"
      ],
      "agents": "./com.cursor/agents/",
      "rules": "./com.cursor/rules/"
    },
    "moe.akr.aghub": {
      "category": "Developer tools",
      "source": {
        "repo": "https://github.com/cursor/plugins",
        "path": "cursor-team-kit"
      }
    }
  }
}
