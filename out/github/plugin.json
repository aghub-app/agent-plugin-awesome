{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "github",
  "version": "1.0.0",
  "description": "Manage repos, issues, pull requests, and Actions.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://docs.github.com/en/copilot/how-tos/context/use-mcp/use-the-github-mcp-server",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "keywords": [
    "github",
    "git",
    "repositories",
    "pull-requests",
    "issues",
    "actions",
    "mcp"
  ],
  "extensions": {
    "com.cursor": {
      "displayName": "GitHub",
      "logo": "assets/logo.svg",
      "category": "integrations",
      "tags": [
        "github",
        "git",
        "mcp",
        "repositories"
      ],
      "minClientVersions": {
        "cursor": "3.13.0"
      },
      "variables": {
        "type": "object",
        "properties": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": {
            "type": "string",
            "title": "GitHub personal access token",
            "description": "Fine-grained or classic PAT from https://github.com/settings/tokens with the repo scopes you want the agent to use."
          }
        },
        "required": [
          "GITHUB_PERSONAL_ACCESS_TOKEN"
        ]
      },
      "mcpServers": {
        "github": {
          "headers": {
            "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
          }
        }
      }
    },
    "moe.akr.aghub": {
      "category": "Integrations",
      "source": {
        "repo": "https://github.com/cursor/plugins",
        "path": "third_party/github"
      }
    }
  }
}
