{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wrike",
  "version": "1.0.0",
  "description": "Search projects, create tasks, and post comments.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://developers.wrike.com/docs/wrike-mcp-server-overview",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "keywords": [
    "wrike",
    "project-management",
    "tasks",
    "projects",
    "work-management",
    "mcp"
  ],
  "extensions": {
    "com.cursor": {
      "displayName": "Wrike",
      "logo": "assets/logo.png",
      "category": "integrations",
      "tags": [
        "wrike",
        "project-management",
        "mcp",
        "tasks"
      ],
      "minClientVersions": {
        "cursor": "3.13.0"
      },
      "variables": {
        "type": "object",
        "properties": {
          "WRIKE_ACCESS_TOKEN": {
            "type": "string",
            "title": "Wrike permanent access token",
            "description": "Permanent access token created in Wrike under Apps & Integrations → API."
          }
        },
        "required": [
          "WRIKE_ACCESS_TOKEN"
        ]
      },
      "mcpServers": {
        "wrike": {
          "headers": {
            "Authorization": "Bearer ${WRIKE_ACCESS_TOKEN}"
          }
        }
      }
    },
    "moe.akr.aghub": {
      "category": "Integrations",
      "source": {
        "repo": "https://github.com/cursor/plugins",
        "path": "third_party/wrike"
      }
    }
  }
}
