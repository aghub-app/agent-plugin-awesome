{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "smartsheet",
  "version": "1.0.0",
  "description": "Query and update sheets, rows, and workspaces.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://developers.smartsheet.com/ai-mcp/smartsheet/mcp-server",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "keywords": [
    "smartsheet",
    "sheets",
    "project-management",
    "work-management",
    "rows",
    "mcp"
  ],
  "extensions": {
    "com.cursor": {
      "displayName": "Smartsheet",
      "logo": "assets/logo.png",
      "category": "integrations",
      "tags": [
        "smartsheet",
        "project-management",
        "mcp"
      ],
      "minClientVersions": {
        "cursor": "3.13.0"
      },
      "variables": {
        "type": "object",
        "properties": {
          "SMARTSHEET_API_TOKEN": {
            "type": "string",
            "title": "Smartsheet API token",
            "description": "API access token generated in Smartsheet under Account → Personal Settings → API Access."
          }
        },
        "required": [
          "SMARTSHEET_API_TOKEN"
        ]
      },
      "mcpServers": {
        "smartsheet": {
          "headers": {
            "Authorization": "Bearer ${SMARTSHEET_API_TOKEN}"
          }
        }
      }
    },
    "moe.akr.aghub": {
      "category": "Integrations",
      "source": {
        "repo": "https://github.com/cursor/plugins",
        "path": "third_party/smartsheet"
      }
    }
  }
}
