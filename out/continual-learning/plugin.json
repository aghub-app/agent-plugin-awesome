{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "continual-learning",
  "version": "1.0.0",
  "description": "Incrementally learns durable user preferences and workspace facts from transcript changes and keeps AGENTS.md up to date with plain bullet points.",
  "author": {
    "name": "Eric Zakariasson"
  },
  "homepage": "https://github.com/cursor/plugins",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "keywords": [
    "continual-learning",
    "agent-memory",
    "transcripts",
    "hooks",
    "incremental"
  ],
  "extensions": {
    "com.cursor": {
      "displayName": "Continual Learning",
      "logo": "assets/avatar.png",
      "category": "developer-tools",
      "tags": [
        "automation",
        "memory",
        "transcripts"
      ],
      "agents": "./com.cursor/agents/",
      "hooks": "./com.cursor/hooks/hooks.json"
    },
    "moe.akr.aghub": {
      "category": "Developer tools",
      "source": {
        "repo": "https://github.com/cursor/plugins",
        "path": "continual-learning"
      }
    }
  }
}
