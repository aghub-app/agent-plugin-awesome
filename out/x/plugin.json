      "tags": [
        "x",
        "social",
        "search",
        "mcp"
      ],
      "minClientVersions": {
        "cursor": "3.13.0"
      },
      "mcpServers": {
        "x": {
          "auth": {
            "CLIENT_ID": "NGdZYmo4VVp2T1BnRG55NlExOGQ6MTpjaQ",
            "scopes": [
              "tweet.read",
              "users.read",
              "follows.read",
              "space.read",
              "mute.read",
              "like.read",
              "list.read",
              "list.write",
              "block.read",
